{
  "name": "chatbot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic RAG backend for the Fumadocs documentation portal",
  "main": "dist/index.js",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "ingest": "ts-node src/ingestion/pipeline.ts",
    "test": "node --require ts-node/register --require ./test/setup.ts --test test/mdx.test.ts test/chunker.test.ts test/security.test.ts test/tenancy.test.ts test/rate-limit.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "cohere-ai": "8.1.0",
    "dotenv": "18.0.7",
    "gray-matter": "4.0.3",
    "hono": "4.13.13",
    "js-tiktoken": "1.0.21",
    "langfuse": "3.39.2",
    "node-html-parser": "9.0.4",
    "openai": "7.32.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "typesense": "3.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
