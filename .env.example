# ---- Server ----
NODE_ENV=development
PORT=8787
LOG_LEVEL=info
# Admin API key (portal management, ingest for any portal). Leave empty to disable the admin API.
# Generate with: openssl rand -base64 48   (min 32 chars; the placeholder below is rejected at boot)
ADMIN_API_KEY=change-me
# Chat requests per minute, per client IP, per portal
RATE_LIMIT_PER_IP_PER_MINUTE=60
# Chat requests per minute for a whole portal (a portal's own setting overrides this)
DEFAULT_PORTAL_RATE_LIMIT_PER_MINUTE=600
# Set to true only behind a reverse proxy you control (X-Forwarded-For is then trusted)
TRUST_PROXY=false
# Max request body for POST /v1/portals/:id/ingest
INGEST_MAX_BODY_MB=50

# ---- OpenAI ----
OPENAI_API_KEY=sk-...
CHAT_MODEL=gpt-4o
FAST_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-large
# text-embedding-3-large is 3072-d natively. Changing this after the first migration requires a new database.
EMBEDDING_DIMENSIONS=3072

# ---- Postgres + pgvector ----
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=chatbot
DATABASE_URL=postgres://chatbot:chatbot@localhost:5432/chatbot

# ---- Typesense ----
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=local-typesense-key
TYPESENSE_COLLECTION=portal_chunks

# ---- Cohere reranker (optional; falls back to fusion ranking if unset) ----
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# ---- Langfuse (optional) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
